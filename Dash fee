-- Arrastar
local arrastando, moveu = false, false
local inicioInput, posInicial

botao.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        arrastando = true
        moveu = false
        inicioInput = input.Position
        posInicial = botao.Position
    end
end)

botao.InputChanged:Connect(function(input)
    if not arrastando then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        local d = input.Position - inicioInput
        if math.abs(d.X) > 5 or math.abs(d.Y) > 5 then moveu = true end
        botao.Position = UDim2.new(
            posInicial.X.Scale, posInicial.X.Offset + d.X,
            posInicial.Y.Scale, posInicial.Y.Offset + d.Y
        )
    end
end)

botao.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        arrastando = false
    end
end)

-- Animação do botão ao clicar
local function animarClique()
    local encolher = TweenService:Create(botao,
        TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Size = UDim2.new(0, CONFIG.TamanhoBotao * 0.8, 0, CONFIG.TamanhoBotao * 0.8) }
    )
    encolher:Play()
    encolher.Completed:Wait()
    TweenService:Create(botao,
        TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        { Size = UDim2.new(0, CONFIG.TamanhoBotao, 0, CONFIG.TamanhoBotao) }
    ):Play()
end

local function iniciarPulso()
    if not botao or not botao.Parent then return end
    local p = TweenService:Create(botao,
        TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
        { BackgroundTransparency = 0.35 }
    )
    p:Play()
    return p
end

local pulsoAtual = iniciarPulso()

-- ============================================================
-- EFEITOS
-- ============================================================
local function criarTrail()
    if not RootPart or not RootPart.Parent then return end
    local a0 = Instance.new("Attachment")
    a0.Position = Vector3.new(0, 1, 0)
    a0.Parent = RootPart
    local a1 = Instance.new("Attachment")
    a1.Position = Vector3.new(0, -1, 0)
    a1.Parent = RootPart
    local trail = Instance.new("Trail")
    trail.Attachment0 = a0
    trail.Attachment1 = a1
    trail.Lifetime = 0.5
    trail.MinLength = 0
    trail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(0.5, 0.3),
        NumberSequenceKeypoint.new(1, 1),
    })
    trail.Color = ColorSequence.new(CONFIG.CorDoEfeito, Color3.fromRGB(255, 255, 255))
    trail.Parent = RootPart
    return trail, a0, a1
end

local function criarParticulas()
    if not CONFIG.EfeitoDeParticula or not RootPart or not RootPart.Parent then return end
    local e = Instance.new("ParticleEmitter")
    e.Texture = "rbxassetid://243660364"
    e.Color = ColorSequence.new(CONFIG.CorDoEfeito, Color3.fromRGB(255, 200, 100))
    e.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 2),
        NumberSequenceKeypoint.new(1, 0),
    })
    e.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.2),
        NumberSequenceKeypoint.new(1, 1),
    })
    e.Lifetime = NumberRange.new(0.4, 0.7)
    e.Speed = NumberRange.new(20, 40)
    e.SpreadAngle = Vector2.new(180, 180)
    e.Rate = 0
    e.Parent = RootPart
    e:Emit(30)
    game:GetService("Debris"):AddItem(e, 1)
end

local function criarAfterimage()
    if not CONFIG.RastroDeImagem or not Character or not Character.Parent then return end
    task.spawn(function()
        for i = 1, 4 do
            if not Character or not Character.Parent or not RootPart or not RootPart.Parent then break end
            local clone = Character:Clone()
            clone.Name = "FeDash_Ghost"
            clone.Parent = workspace
            for _, obj in ipairs(clone:GetDescendants()) do
                if obj:IsA("Script") or obj:IsA("LocalScript")
                or obj:IsA("Animator") or obj:IsA("Sound")
                or obj:IsA("ParticleEmitter") or obj:IsA("Trail")
                or obj:IsA("Attachment") or obj:IsA("Decal")
                or obj:IsA("Humanoid") then
                    obj:Destroy()
                elseif obj:IsA("BasePart") then
                    obj.Anchored = true
                    obj.CanCollide = false
                    obj.Material = Enum.Material.Neon
                    obj.Color = CONFIG.CorDoEfeito
                    obj.Transparency = 0.4
                end
            end
            task.spawn(function()
                local info = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                for _, obj in ipairs(clone:GetDescendants()) do
                    if obj:IsA("BasePart") then
                        TweenService:Create(obj, info, { Transparency = 1 }):Play()
                    end
                end
            end)
            game:GetService("Debris"):AddItem(clone, 0.7)
            task.wait(0.07)
        end
    end)
end

local function tremorCamera()
    if not CONFIG.CameraShake then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    task.spawn(function()
        local dur = 0.3
        local intens = 1.2
        local ini = tick()
        while tick() - ini < dur do
            local f = intens * (1 - (tick() - ini) / dur)
            cam.CFrame = cam.CFrame * CFrame.new(
                (math.random() - 0.5) * f,
                (math.random() - 0.5) * f,
                0
            )
            RunService.RenderStepped:Wait()
        end
    end)
end

local function tocarSom()
    if not CONFIG.Som then return end
    if CONFIG.SomId == "" then return end
    if not RootPart or not RootPart.Parent then return end
    local s = Instance.new("Sound")
    s.SoundId = CONFIG.SomId
    s.Volume = 0.6
    s.Parent = RootPart
    s:Play()
    game:GetService("Debris"):AddItem(s, 2)
end

-- ============================================================
-- DASH
-- ============================================================
local function executarDash()
    if CooldownAtivo or DashAtivo then return end
    if not atualizarRefs() then return end
    if Humanoid.Health <= 0 then return end
    
    CooldownAtivo = true
    DashAtivo = true
    print("[Fe Dash] 🚀 Dash!")
    
    task.spawn(animarClique)
    stroke.Color = Color3.fromRGB(120, 120, 120)
    botao.BackgroundTransparency = 0.6
    if pulsoAtual then pulsoAtual:Cancel() end
    
    -- Direção
    local dir = Humanoid.MoveDirection
    if dir.Magnitude < 0.1 then
        dir = RootPart.CFrame.LookVector
    else
        dir = dir.Unit
    end
    
    -- 🎬 ANIMAÇÃO MANUAL
    animarPersonagem()
    
    -- Efeitos
    local trail, a0, a1 = criarTrail()
    if trail then trail.Enabled = true end
    criarParticulas()
    criarAfterimage()
    tremorCamera()
    tocarSom()
    
    -- Impulso
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e5, 0, 1e5)
    bv.Velocity = dir * CONFIG.Forca
    bv.Parent = RootPart
    
    task.spawn(function()
        local ini = tick()
        while tick() - ini < CONFIG.Duracao do
            if not RootPart or not RootPart.Parent then break end
            bv.Velocity = dir * CONFIG.Forca
            RunService.Heartbeat:Wait()
        end
        if bv then bv:Destroy() end
    end)
    
    task.delay(CONFIG.Duracao + 0.5, function()
        if trail then trail.Enabled = false end
        if a0 then a0:Destroy() end
        if a1 then a1:Destroy() end
        if trail then trail:Destroy() end
    end)
    
    DashAtivo = false
    
    task.delay(CONFIG.Cooldown, function()
        CooldownAtivo = false
        stroke.Color = CONFIG.CorDoEfeito
        botao.BackgroundTransparency = 0.15
        pulsoAtual = iniciarPulso()
    end)
end

-- Inputs
botao.MouseButton1Click:Connect(function()
    if not moveu then executarDash() end
end)

botao.TouchTap:Connect(function()
    if not moveu then executarDash() end
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == CONFIG.Tecla then
        executarDash()
    end
end)

