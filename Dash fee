local function atualizarRefs()
    Character = LocalPlayer.Character
    if not Character then return false end
    Humanoid = Character:FindFirstChildOfClass("Humanoid")
    RootPart = Character:FindFirstChild("HumanoidRootPart")
    return Humanoid and RootPart
end

if not atualizarRefs() then
    LocalPlayer.CharacterAdded:Wait()
    task.wait(0.5)
    atualizarRefs()
end

LocalPlayer.CharacterAdded:Connect(function(c)
    Character = c
    Humanoid = c:WaitForChild("Humanoid")
    RootPart = c:WaitForChild("HumanoidRootPart")
end)

print("[Fe Dash] Iniciando...")

-- ============================================================
-- ANIMAÇÃO MANUAL (via Motor6D) — não usa ID
-- ============================================================
local function acharMotores()
    if not Character then return {} end
    local motores = {}
    local isR15 = Character:FindFirstChild("UpperTorso") ~= nil
    
    local alvos
    if isR15 then
        alvos = {
            "RightShoulder", "LeftShoulder",
            "RightHip", "LeftHip",
            "RightElbow", "LeftElbow",
            "RightKnee", "LeftKnee",
        }
    else
        alvos = {
            "Right Shoulder", "Left Shoulder",
            "Right Hip", "Left Hip",
        }
    end
    
    for _, nome in ipairs(alvos) do
        for _, obj in ipairs(Character:GetDescendants()) do
            if obj:IsA("Motor6D") and obj.Name == nome then
                motores[nome] = { motor = obj, c0 = obj.C0 }
                break
            end
        end
    end
    return motores
end

local function pararAnimacoesHumanoid()
    if not Humanoid then return end
    local anim = Humanoid:FindFirstChildOfClass("Animator")
    if not anim then return end
    for _, track in ipairs(anim:GetPlayingAnimationTracks()) do
        pcall(function() track:Stop(0) end)
    end
end

local function animarPersonagem()
    if not Character or not Character.Parent then return end
    
    local motores = acharMotores()
    if not next(motores) then
        warn("[Fe Dash] Nenhum motor encontrado")
        return
    end
    
    -- Para animações pra não sobrescreverem nosso C0
    pararAnimacoesHumanoid()
    
    -- Aplica pose com alpha 0..1
    local function aplicarPose(alpha)
        for nome, dados in pairs(motores) do
            local m = dados.motor
            if not m or not m.Parent then continue end
            
            local base = dados.c0
            local novaC0 = base
            
            if nome:find("Shoulder") then
                -- Braços vão pra trás e pra cima (pose de dash)
                novaC0 = base * CFrame.Angles(math.rad(-110 * alpha), 0, math.rad(15 * alpha))
            elseif nome:find("Hip") then
                -- Uma perna pra frente, outra pra trás (passada larga)
                local dir = nome:find("Right") and 1 or -1
                novaC0 = base * CFrame.Angles(math.rad(45 * alpha * dir), 0, 0)
            elseif nome:find("Elbow") then
                novaC0 = base * CFrame.Angles(math.rad(-30 * alpha), 0, 0)
            elseif nome:find("Knee") then
                novaC0 = base * CFrame.Angles(math.rad(60 * alpha), 0, 0)
            end
            
            m.C0 = novaC0
        end
    end
    
    task.spawn(function()
        local subida = 0.08
        local descida = 0.25
        
        -- Subir pose
        local t0 = tick()
        while tick() - t0 < subida do
            local a = (tick() - t0) / subida
            aplicarPose(a)
            RunService.RenderStepped:Wait()
        end
        aplicarPose(1)
        
        -- Segurar
        task.wait(math.max(0, CONFIG.Duracao - subida))
        
        -- Voltar
        local t1 = tick()
        while tick() - t1 < descida do
            local a = 1 - ((tick() - t1) / descida)
            aplicarPose(a)
            RunService.RenderStepped:Wait()
        end
        
        -- Restaurar C0 original
        for _, dados in pairs(motores) do
            if dados.motor and dados.motor.Parent then
                dados.motor.C0 = dados.c0
            end
        end
        print("[Fe Dash] ✅ Animação finalizada")
    end)
end

